BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/your_webhook_key
# Optional: full URL to method, has priority over BITRIX_WEBHOOK_URL
# BITRIX_LEAD_ADD_URL=https://your-portal.bitrix24.ru/rest/1/your_webhook_key/crm.lead.add.json

# Optional lead defaults
BITRIX_LEAD_TITLE_PREFIX=Заявка с сайта
BITRIX_SOURCE_ID=WEB
# BITRIX_ASSIGNED_BY_ID=1

DATABASE_URL=postgres://postgres:postgres@localhost:5432/highway
# Set DATABASE_SSL=1 for managed Postgres
# DATABASE_SSL=1

SESSION_SECRET=change-me
ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH=$argon2id$...
# Optional (default 8h)
# ADMIN_SESSION_TTL_SECONDS=28800

S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=highway-media
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...
S3_PUBLIC_BASE_URL=https://cdn.example.com/highway-media

# Public base URL for canonical/sitemap
NEXT_PUBLIC_SITE_URL=https://highwaymotors.site
SITE_URL=https://highwaymotors.site

# Chat widget (set ONE option below)
# 1) Full script URL from your provider (recommended)
NEXT_PUBLIC_CHAT_WIDGET_SRC=
# 2) Or Jivo widget ID (fallback to https://code.jivo.ru/widget/<ID>)
NEXT_PUBLIC_JIVO_WIDGET_ID=
